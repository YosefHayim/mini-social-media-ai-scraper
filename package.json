{
  "name": "mini-social-media-ai-scraper",
  "version": "0.0.4",
  "description": "Small social media scraper CLI: YouTube captions (video, playlist, channel) and Instagram reels (mp4/mp3 + local whisper transcript), with optional local-agent SKILL.md scaffolding",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Yosef Hayim Sabag",
  "homepage": "https://github.com/YosefHayim/mini-social-media-ai-scraper",
  "bugs": {
    "url": "https://github.com/YosefHayim/mini-social-media-ai-scraper/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YosefHayim/mini-social-media-ai-scraper.git"
  },
  "keywords": [
    "youtube",
    "instagram",
    "reels",
    "whisper",
    "captions",
    "transcript",
    "subtitles",
    "cli",
    "innertube",
    "playlist",
    "channel",
    "agent-skills",
    "typescript"
  ],
  "main": "dist/main.js",
  "bin": {
    "mini-social-media-ai-scraper": "dist/main.js"
  },
  "exports": {
    ".": "./dist/main.js"
  },
  "files": [
    "dist",
    "config",
    "llms.txt",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/ensure-bin-shebang.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "canary": "node dist/main.js url=https://www.youtube.com/watch?v=dQw4w9WgXcQ lang=en auto output-format=txt out-dir=./scraped-yt-canary concurrency=1 no-cache"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "effect": "^3.22.1",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}
